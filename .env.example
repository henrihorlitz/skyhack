# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# OpenRouter (preferred when set) — openrouter.ai/keys. Uses the Anthropic-compatible endpoint.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# Anthropic (used only when OPENROUTER_API_KEY is empty) — console.anthropic.com → API Keys (create a NEW key with a spend limit)
ANTHROPIC_API_KEY=
# Optional: claude-opus-5 (default, smartest) or claude-sonnet-5 (faster, cheaper)
ANTHROPIC_MODEL=claude-opus-5
# Optional: low | medium | high — lower = faster on stage
ANTHROPIC_EFFORT=medium

# ElevenLabs — elevenlabs.io → Developers → API Keys
ELEVENLABS_API_KEY=
# Optional: pick a voice at elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=
# Voice agent (real-time calls). Create it with: bun scripts/create-voice-agent.ts
ELEVENLABS_AGENT_ID=

# Supabase — project → Settings → API (use the *publishable* key, never the secret key here)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel CLI token (local only, NOT uploaded to Vercel) — vercel.com/account/settings/tokens
VERCEL_TOKEN=
